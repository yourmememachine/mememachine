# Build outputs and runtime state — not committed.
# The repo ships the genesis (ledger/), the docs, and the scripts.
# Binaries are fetched by ./install.sh; the working ledger is created
# by ./start-validator.sh.

bin/
bin-extra/
solana-release/
*.tar.bz2
ledger-test/
*.log
# Livenet secrets and runtime state — NEVER committed.
# Keys are generated on the deployment host; the livenet genesis and
# per-validator ledgers are generated at deploy time.
livenet/keys/
livenet/ledger/
livenet/ledgers/
livenet/genesis-info.env
livenet/.primordial.yaml
# Bridge build outputs and relayer runtime state — not committed.
bridge/target/
bridge-attestations/
relayer-state.json
*.tmp
